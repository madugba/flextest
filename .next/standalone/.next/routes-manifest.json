{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/timer/[sessionId]",
      "regex": "^/api/timer/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsessionId": "nxtPsessionId"
      },
      "namedRegex": "^/api/timer/(?<nxtPsessionId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/dashboard/reports/[sessionId]/scores",
      "regex": "^/dashboard/reports/([^/]+?)/scores(?:/)?$",
      "routeKeys": {
        "nxtPsessionId": "nxtPsessionId"
      },
      "namedRegex": "^/dashboard/reports/(?<nxtPsessionId>[^/]+?)/scores(?:/)?$"
    },
    {
      "page": "/questions/upload/[sessionId]",
      "regex": "^/questions/upload/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsessionId": "nxtPsessionId"
      },
      "namedRegex": "^/questions/upload/(?<nxtPsessionId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/questions/upload/[sessionId]/[subjectId]",
      "regex": "^/questions/upload/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPsessionId": "nxtPsessionId",
        "nxtPsubjectId": "nxtPsubjectId"
      },
      "namedRegex": "^/questions/upload/(?<nxtPsessionId>[^/]+?)/(?<nxtPsubjectId>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
