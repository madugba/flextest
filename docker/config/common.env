# ============================================
# DOCKER ENVIRONMENT CONFIGURATION
# ============================================
# Common environment variables for Docker deployment
# This file is used by docker-compose.yml
#
# SECURITY WARNING:
# - Never commit sensitive values to version control
# - Rotate secrets regularly (every 90 days minimum)
# - Restrict file permissions: chmod 600 common.env
#
# Last Updated: 2025-10-17
# Environment: Docker Production
# ============================================

# ============================================
# Application Settings
# ============================================
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# ============================================
# gRPC Server
# ============================================
GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# ============================================
# PostgreSQL Database (Docker)
# ============================================
# Production credentials configured
# Using Docker service names for hostname (internal container ports)
#
# Via PgBouncer (Recommended for production)
# Note: Use port 5432 (PgBouncer's internal port), not 6433 (host-mapped port)
DATABASE_URL=postgresql://prod_user:QSbM08uqLc7nK81WZfw53%2FID%2BfJ6UAL8@pgbouncer:5432/flextest_db?connection_limit=150&pool_timeout=10&connect_timeout=10

# Direct connection (for migrations and admin tasks)
DIRECT_URL=postgresql://prod_user:QSbM08uqLc7nK81WZfw53%2FID%2BfJ6UAL8@postgres:5432/flextest_db

# PgBouncer Admin Connection (for metrics collection)
PGBOUNCER_ADMIN_URL=postgresql://prod_user:QSbM08uqLc7nK81WZfw53%2FID%2BfJ6UAL8@pgbouncer:5432/pgbouncer

# PostgreSQL Configuration
POSTGRES_DB=flextest_db
POSTGRES_USER=prod_user
POSTGRES_PASSWORD=QSbM08uqLc7nK81WZfw53/ID+fJ6UAL8

# ============================================
# Redis Cache (Docker)
# ============================================
# Using Docker service name for hostname
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=Z2e0Qjfjsz1WTBUkNq5bjB9yMYxN28rw
REDIS_DB=0
REDIS_TLS=false
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000
REDIS_KEY_PREFIX=flextest:prod:

# ============================================
# Security Settings
# ============================================
# JWT Secret: 512-bit cryptographically secure random value
# Generated: Wed Oct 8 13:57:52 CEST 2025
# Rotate every 90 days minimum
JWT_SECRET=OV8i4DjYLwPeRjnPTt2gyZQDIwlY+qypj3NDjIknFtU3T5MKmLQwk+GFm+AxQJBamvmzfgUnJvJayWLoLHmfBA==

# JWT Configuration
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
JWT_ALGORITHM=HS512

# Password Hashing
# Optimized for 5M users (10 rounds = 4x faster than 12, still very secure)
BCRYPT_ROUNDS=10

# Session Configuration
# 512-bit cryptographically secure random value
SESSION_SECRET=oBCYwud2qxeiwCMxf2CD3a8Ys8/vceWVahR8iRDi0NH6kMSn8YOIOMPlrot/pPyK+bBllw2kGx//8/JKj/eqOQ==
SESSION_COOKIE_MAX_AGE=604800000
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=strict

# ============================================
# Rate Limiting (Production Settings)
# ============================================
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000
RATE_LIMIT_BAN_DURATION=3600000
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# ============================================
# CORS Settings (Production)
# ============================================
# IMPORTANT: Set to your actual frontend domain(s) in production
# Multiple origins: https://app.example.com,https://www.example.com
CORS_ORIGIN=*
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# ============================================
# Performance Settings (Production Optimized)
# ============================================
MAX_PARAM_LENGTH=100
BODY_LIMIT=10485760
REQUEST_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=65000

# Connection Limits
MAX_CONCURRENT_CONNECTIONS=10000
MAX_REQUESTS_PER_SOCKET=0

# ============================================
# Backup Configuration
# ============================================
# Directory for database backups
BACKUP_DIR=/var/backups/flextest
BACKUP_KEEP_COUNT=30
BACKUP_COMPRESS=true
BACKUP_SCHEDULE=0 2 * * *

# ============================================
# Monitoring and Observability
# ============================================
# Prometheus Metrics
ENABLE_METRICS=true
METRICS_PORT=9090
METRICS_PATH=/metrics

# ============================================
# Feature Flags
# ============================================
ENABLE_SIGNUP=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_2FA=false
ENABLE_API_DOCS=false
MAINTENANCE_MODE=false

# ============================================
# Cluster Configuration (PM2)
# ============================================
PM2_INSTANCES=max
PM2_EXEC_MODE=cluster
PM2_MAX_MEMORY_RESTART=500M
PM2_MIN_UPTIME=10000
PM2_MAX_RESTARTS=10
PM2_AUTORESTART=true

# ============================================
# Health Check Configuration
# ============================================
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=5000
DATABASE_HEALTH_CHECK_INTERVAL=30000
REDIS_HEALTH_CHECK_INTERVAL=30000

# ============================================
# Reverse Proxy Configuration
# ============================================
# Set if behind nginx/HAProxy
TRUST_PROXY=true
PROXY_DEPTH=1

# ============================================
# Logging Configuration
# ============================================
LOG_FORMAT=json
LOG_PRETTY=false
LOG_REDACT_PATHS=password,token,secret,authorization
LOG_MAX_FILES=30
LOG_MAX_SIZE=100m

# ============================================
# Database Performance Tuning
# ============================================
# Connection Pool Settings
DATABASE_CONNECTION_LIMIT=100
DATABASE_POOL_TIMEOUT=10
PGBOUNCER_ENABLED=true
PGBOUNCER_PORT=6433
PGBOUNCER_MAX_CLIENT_CONN=10000
PGBOUNCER_POOL_SIZE=100

# Query Logging (disable in production for performance)
PRISMA_QUERY_LOG=false
SLOW_QUERY_THRESHOLD=1000

# ============================================
# Frontend Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3000/v1/api
